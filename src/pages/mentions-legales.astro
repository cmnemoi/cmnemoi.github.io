<style>
  article { padding-block: clamp(56px, 8vw, 120px); max-width: 820px; }
  h1 { font-size: var(--fs-headline); margin-bottom: 48px; }
  h2 { font-size: var(--fs-step); font-weight: 900; margin: 40px 0 10px; }
  p + p { margin-top: 12px; }
</style>
