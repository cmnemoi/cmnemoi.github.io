---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CALENDLY, EMAIL, LINKEDIN } from '../site';
import { TALKS } from '../talks';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const today = new Date();
const dateFr = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const steps = [
  { n: '01', label: 'Prototype', done: true },
  { n: '02', label: 'Build', done: true },
  { n: '03', label: 'Déploiement', done: true },
  { n: '04', label: 'En prod', done: true },
  { n: '05', label: 'Fiabiliser' },
  { n: '06', label: 'Maintenir' },
  { n: '07', label: 'Accélérer' },
];

const pains = [
  'On n’ose plus toucher au prompt.',
  'Chaque correction casse autre chose.',
  'On ne sait pas si la nouvelle version répond mieux que l’ancienne.',
  'On livrait vite au début. Plus maintenant.',
];

const fronts = [
  {
    n: '05', title: 'Fiabiliser',
    text: 'Vous savez si une nouvelle version répond mieux que l’ancienne avant de la livrer, pas après les retours des utilisateurs.',
    items: ['Tests automatisés sur le code autour du modèle', 'Évaluation automatique des réponses sur des questions de référence écrites avec le métier', 'Une CI qui bloque les régressions à chaque push', 'Logs et traces pour comprendre une mauvaise réponse en prod'],
  },
  {
    n: '06', title: 'Maintenir',
    text: 'Changer un prompt, un modèle ou un outil ne casse plus le reste du produit.',
    items: ['Vos règles métier ne dépendent d’aucun modèle ni fournisseur de LLM : en changer devient un détail', 'Prompts versionnés et déployés comme du code : chaque changement est traçable et réversible', 'Refactoring progressif, sans geler les livraisons'],
  },
  {
    n: '07', title: 'Accélérer',
    text: 'Votre équipe livre mieux, plus vite et dans de bonnes conditions. Je m’appuie sur les capacités DORA, issues de plus de dix ans de recherche sur les équipes qui livrent.',
    items: ['Des petits lots livrés souvent, sur une branche principale toujours déployable', 'Un déploiement automatisé, sans circuit de validation manuelle qui bloque la file', 'Les quatre indicateurs DORA mesurés : vous savez si l’équipe accélère vraiment'],
  },
];

const logos = [
  { src: '/logos/lexisnexis.svg', alt: 'LexisNexis', h: 30 },
  { src: '/logos/adeo.svg', alt: 'ADEO (Leroy Merlin)', h: 44 },
  { src: '/logos/servier.svg', alt: 'Servier', h: 32 },
  { src: '/logos/roubaix.svg', alt: 'Ville de Roubaix', h: 34 },
  { src: '/logos/eternaltwin.svg', alt: 'Eternaltwin', h: 50 },
];

const reviews = [
  { who: 'Romain Philippe', role: 'Lead Data Scientist, Servier', text: 'Charles a joué un rôle déterminant dans un projet d’assistant IA basé sur un RAG, déployé sur Google Cloud Run, qui a permis à plus de 500 collaborateurs d’accroître leur productivité. […] Ce qui m’a le plus marqué : son autonomie, sa maturité et rigueur technique, et sa volonté de mener des projets de bout en bout, de la conception à la production.' },
  { who: 'Guillaume Astor', role: 'Data Engineering Manager, SFEIR', text: 'Il a joué un rôle clé dans la migration du prototype vers une API FastAPI robuste, ainsi que dans le monitoring des pipelines d’indexation qui garantissent aujourd’hui la qualité et la fraîcheur des données.' },
  { who: 'William Dechamps', role: 'Développeur full-stack, ex-Orange, contributeur eMush', text: 'Ce qui m’a le plus marqué, c’est sa disponibilité et sa pédagogie : il a toujours pris le temps de répondre à mes questions, de m’orienter vers les bonnes pratiques du projet et de proposer des revues de code constructives.' },
  { who: 'Robin Deparpe', role: 'Consultant fonctionnel, Devoteam', text: 'Ce qui m’a le plus marqué, c’est sa capacité à accompagner les développeurs, qu’ils soient débutants ou expérimentés, tout en gardant une vision technique et fonctionnelle claire.' },
  { who: 'Bryen Param', role: 'ML Engineer, ex-Total, Servier', text: 'Ce qui m’a le plus marqué, c’est sa capacité à expliquer clairement des concepts complexes et à m’accompagner dans ma montée en compétences sur Python, les bonnes pratiques de développement et les pipelines CI/CD.' },
  { who: 'Anthony Cyrille', role: 'CTO et formateur, eSWIT', text: 'Son approche est structurée, pragmatique et orientée qualité. Il pose de bonnes questions, challenge les choix techniques avec bienveillance et pédagogie.' },
];
---
<Base title="Accueil" description="Ingénieur IA freelance. Votre agent IA est en prod, et après ? J’interviens après vos premières mises en prod : je rends votre produit IA fiable et maintenable, puis j’accélère vos livraisons.">

  <!-- HERO -->
  <section class="hero wrap">
    <p class="badge"><i></i>En mission · Prochaines disponibilités à discuter</p>
    <h1 class="display">Votre agent IA <br class="lg" />est en prod.<br />Et <em>après</em>&nbsp;?</h1>
    <div class="hero-row">
      <p class="lede">J’interviens après vos premières mises en prod. Je rends votre produit IA <b>fiable et maintenable</b>, puis j’accélère vos livraisons.</p>
      <a class="btn big" href={CALENDLY}>Réserver un appel de 30&nbsp;min <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" /></svg></a>
    </div>
    <ol class="rail" aria-label="Le cycle de vie d’un produit IA">
      {steps.map((s) => (
        <li class:list={['step', s.done ? 'done' : 'ghost']}>
          {s.n === '04' && <span class="here">Vous êtes ici</span>}
          <span class="num">{s.n}{s.done && <svg viewBox="0 0 16 16" aria-label="terminé"><path d="m3 8.5 3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>}</span>
          <span class="label">{s.label}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- CHIFFRES -->
  <section class="proof wrap" aria-label="Quelques chiffres">
    <figure class="fig">
      <div class="dots" aria-hidden="true">{Array.from({ length: 50 }, () => <i />)}</div>
      <p class="big">500+</p>
      <figcaption>collaborateurs utilisent le chatbot RAG que j’ai contribué à industrialiser chez Servier.</figcaption>
    </figure>
    <figure class="fig">
      <div class="bar" aria-hidden="true"><span style="width:80%"></span></div>
      <p class="big">80&nbsp;%</p>
      <figcaption>de bonnes réponses, mesurées par une évaluation automatique lancée à chaque push.</figcaption>
    </figure>
    <figure class="fig">
      <div class="stack" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <p class="big">500&nbsp;k€</p>
      <figcaption>d’économies par an pour le produit de suivi de production de médicaments auquel j’ai contribué.</figcaption>
    </figure>
    <figure class="fig">
      <div class="before" aria-hidden="true"><span class="was">Avant : plusieurs semaines</span><span class="now"></span></div>
      <p class="big">10&nbsp;min</p>
      <figcaption>pour générer 160 tableaux de bord à la Ville de Roubaix, contre plusieurs semaines avant.</figcaption>
    </figure>
  </section>

  <!-- LOGOS -->
  <div class="logos" aria-label="Ils m’ont fait confiance">
    <p class="wrap">Ils m’ont fait confiance</p>
    <div class="marquee">
      {[0, 1].map((copy) => (
        <ul aria-hidden={copy === 1 ? 'true' : undefined}>
          {logos.map((l) => <li><img src={l.src} alt={copy === 0 ? l.alt : ''} style={`height:${l.h}px`} loading="lazy" /></li>)}
        </ul>
      ))}
    </div>
  </div>

  <!-- DOULEURS -->
  <section class="pains wrap">
    <h2 class="display">Une de ces phrases vous dit quelque chose&nbsp;?</h2>
    <ul>
      {pains.map((p) => <li>« {p} »</li>)}
    </ul>
    <p class="lede">Elles arrivent quand un produit IA grandit plus vite que le code qui le porte. <b>Ce n’est pas une fatalité, c’est du travail d’ingénierie.</b></p>
  </section>

  <!-- OFFRE -->
  <section id="offre" class="offer wrap rule">
    <h2 class="display">Trois étapes après la <em>mise en prod</em>.</h2>
    <div class="offer-grid">
      <ol class="side-rail" aria-hidden="true">
        <li class="done"><span>04</span>En prod</li>
        {fronts.map((f) => <li data-step={f.n}><span>{f.n}</span>{f.title}</li>)}
      </ol>
      <div>
        {fronts.map((f) => (
          <article class="front" data-front={f.n}>
            <h3><span class="tag">{f.n}</span>{f.title}</h3>
            <p class="lede">{f.text}</p>
            <ul>{f.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
        <dl class="format">
          <div><dt>Format</dt><dd>Temps plein, temps partiel ou forfait</dd></div>
          <div><dt>Lieu</dt><dd>À distance, ou hybride en Île-de-France et Hauts-de-France</dd></div>
          <div><dt>Tarif</dt><dd>Devis après un appel de 30 minutes</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ÉTUDES DE CAS -->
  <section id="cas" class="cases wrap rule">
    <h2 class="display">Deux produits, <em>de près</em>.</h2>

    <article class="case">
      <header>
        <h3>Knowledge Bot : un chatbot RAG utilisé par 500 collaborateurs</h3>
        <p class="meta">Servier · 18 mois</p>
      </header>
      <div class="case-body">
        <p>Un assistant interne qui répond aux questions des équipes à partir de la documentation de l’entreprise. Au départ, un prototype Streamlit. Il fallait le rendre solide pour trois filiales.</p>
        <ul>
          <li>Migration du prototype vers une API FastAPI déployée sur Cloud Run</li>
          <li>Pipelines d’indexation avec Cloud Run Jobs et Workflows</li>
          <li>Évaluation automatique : un LLM note les réponses sur des questions de référence écrites avec le métier, à chaque push dans GitLab CI</li>
          <li>Prompt engineering et découpage des documents, guidés par cette évaluation</li>
          <li>Tests pytest, monitoring Grafana, application Teams</li>
        </ul>
      </div>
      <dl class="results">
        <div><dt>500+</dt><dd>utilisateurs</dd></div>
        <div><dt>80&nbsp;%</dt><dd>de bonnes réponses</dd></div>
        <div><dt>3</dt><dd>filiales : Brésil, Espagne, Italie</dd></div>
      </dl>
    </article>

    <article class="case">
      <header>
        <h3>Protégé : un assistant juridique à base d’agents, en production</h3>
        <p class="meta">LexisNexis · 6 mois</p>
      </header>
      <div class="case-body">
        <p>Un assistant IA utilisé par des professionnels du droit français. Le produit était déjà en production : il fallait le faire évoluer sans casser l’existant.</p>
        <ul>
          <li>Fonctionnalités Python du moteur d’orchestration d’agents</li>
          <li>Routage dynamique de chaque question vers la recherche web ou le RAG agentique</li>
          <li>Support de plusieurs documents dans les workflows à prompts prédéfinis</li>
          <li>Intégration de Mistral de A à Z : un modèle européen, pour un assistant souverain</li>
          <li>Streaming des réponses du chatbot</li>
        </ul>
      </div>
      <dl class="results">
        <div><dt>Agents</dt><dd>orchestration et routage entre outils</dd></div>
        <div><dt>Mistral</dt><dd>intégré de A à Z, pour la souveraineté des données</dd></div>
        <div><dt>Streaming</dt><dd>des réponses, côté API et interface</dd></div>
      </dl>
    </article>
  </section>

  <!-- AVIS -->
  <section id="avis" class="reviews wrap rule">
    <h2 class="display">Ce qu’<em>ils</em> en disent.</h2>
    <div class="review-cols">
      {reviews.map((r) => (
        <blockquote class="review">
          <p>« {r.text} »</p>
          <footer><b>{r.who}</b><br />{r.role}</footer>
        </blockquote>
      ))}
    </div>
    <a class="more" href={`${LINKEDIN}details/recommendations/`}>10+ témoignages supplémentaires sur LinkedIn <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" /></svg></a>
  </section>

  <!-- BLOG -->
  <section class="latest wrap rule">
    <div class="latest-head">
      <h2 class="display">Par <em>écrit</em>.</h2>
      <a href="/blog">Tous les articles</a>
    </div>
    <ul>
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>
            <time datetime={p.data.date.toISOString()}>{dateFr(p.data.date)}</time>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- TALKS -->
  <section class="talks wrap rule">
    <h2 class="display">À voix <em>haute</em>.</h2>
    <ul>
      {TALKS.map((t) => {
        const d = new Date(t.date);
        return (
          <li>
            <time datetime={t.date}>{dateFr(d)}</time>
            <div>
              <h3>{t.event}{t.city && <span> · {t.city}</span>}{d > today && <span class="soon">À venir</span>}</h3>
              <p>{t.title ?? 'Titre à venir'}</p>
            </div>
            <div class="links">
              {t.replay && <a href={t.replay}>Voir le replay</a>}
              {t.url && <a href={t.url}>Page de l’événement</a>}
            </div>
          </li>
        );
      })}
    </ul>
    <p class="invite">Vous organisez un événement&nbsp;? <a href={`mailto:${EMAIL}`}>Écrivez-moi</a>.</p>
  </section>

  <!-- CTA FINAL -->
  <section class="next">
    <div class="wrap">
      <h2 class="display">L’étape 05 commence par un appel de 30&nbsp;minutes.</h2>
      <p>Vous me racontez où en est votre produit IA. Je vous dis honnêtement si je peux vous aider, et comment.</p>
      <div class="cta-row">
        <a class="btn big light" href={CALENDLY}>Réserver un appel <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" /></svg></a>
        <p class="me"><img src="/photo.jpg" alt="" width="56" height="56" loading="lazy" /><span><b>Charles-Meldhine</b><br />Ingénieur IA</span></p>
      </div>
      <ol class="mini-rail" aria-hidden="true">
        <li class="done"><span>04 <svg viewBox="0 0 16 16"><path d="m3 8.5 3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.4" /></svg></span>En prod</li>
        <li class="now"><span>05</span>Fiabiliser</li>
        <li><span>06</span>Maintenir</li>
        <li><span>07</span>Accélérer</li>
      </ol>
    </div>
  </section>
</Base>

<script>
  // Allume les étapes 05–07 quand on atteint chaque front de l'offre, et toutes celles d'avant.
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const n = (e.target as HTMLElement).dataset.front!;
      document.querySelectorAll<HTMLElement>('[data-front], .side-rail [data-step]').forEach((el) => {
        if ((el.dataset.front ?? el.dataset.step)! <= n) el.classList.add('lit');
      });
    }
  }, { rootMargin: '0px 0px -45% 0px' });
  document.querySelectorAll('[data-front]').forEach((el) => io.observe(el));
</script>

<style>
  /* HERO */
  .hero { padding-block: clamp(28px, 3.5vw, 48px) clamp(48px, 6vw, 72px); }
  .badge { display: inline-flex; align-items: center; gap: 10px; border: 1px solid var(--line); padding: 6px 14px; font-size: var(--fs-small); }
  .badge i { width: 8px; height: 8px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 4px rgb(29 59 191 / 0.15); }
  h1 { font-size: var(--fs-display); margin-top: clamp(16px, 2vw, 28px); }
  @media (max-width: 760px) { h1 .lg { display: none; } }
  .hero-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; margin-top: clamp(20px, 2.4vw, 32px); }
  .btn.big { font-size: var(--fs-body); padding: 1.05em 1.6em; }

  .rail { list-style: none; padding: 0; margin-top: clamp(52px, 4.5vw, 64px); display: grid; grid-template-columns: repeat(7, 1fr); border: 1px solid var(--ink); }
  .step { position: relative; padding: 14px 16px 18px; border-right: 1px solid var(--ink); min-height: 92px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px; }
  .step:last-child { border-right: 0; }
  .step .num { display: flex; align-items: center; gap: 6px; font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
  .step .num svg { width: 14px; height: 14px; }
  .step .label { font-weight: 900; text-transform: uppercase; font-size: var(--fs-body); letter-spacing: -0.01em; line-height: 1; }
  .done { background: var(--blue); color: #fff; border-right-color: rgb(255 255 255 / 0.35); }
  .done:nth-child(4) { border-right-color: var(--ink); }
  .ghost { color: #6b7280; background: repeating-linear-gradient(135deg, #fff 0 9px, var(--ghost) 9px 10px); }
  .here { position: absolute; bottom: calc(100% + 10px); left: 0; font-size: var(--fs-label); font-weight: 800; color: var(--blue); white-space: nowrap; }
  .here::after { content: ''; position: absolute; left: 16px; top: calc(100% + 1px); border: 6px solid transparent; border-top-color: var(--blue); }
  @media (max-width: 760px) {
    .rail { grid-template-columns: 1fr; }
    .step { min-height: 0; flex-direction: row; align-items: center; justify-content: flex-start; gap: 14px; padding: 11px 14px; border-right: 0; border-top: 1px solid rgb(255 255 255 / 0.35); }
    .step:first-child { border-top: 0; }
    .ghost, .step:nth-child(5) { border-top-color: var(--ink); }
    .step .num { width: 3.2em; }
    .here { position: static; order: 3; margin-left: auto; color: #fff; }
    .here::after { display: none; }
  }

  /* CHIFFRES */
  .proof { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); padding-block: 0; }
  .fig { padding: 32px 28px 36px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 14px; }
  .fig:first-child { padding-left: 0; }
  .fig:last-child { border-right: 0; padding-right: 0; }
  .big { font-weight: 900; font-size: var(--fs-figure); line-height: 1; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  figcaption { color: var(--mute); font-size: var(--fs-ui); line-height: 1.45; max-width: 30ch; }
  .fig > div { height: 56px; }
  .dots { display: grid; grid-template-columns: repeat(25, 1fr); gap: 4px; align-content: end; max-width: 240px; }
  .dots i { aspect-ratio: 1; background: var(--blue); border-radius: 50%; }
  .bar { display: flex; align-items: flex-end; }
  .bar span { display: block; height: 22px; background: var(--blue); }
  .bar::after { content: ''; flex: 1; height: 22px; background: repeating-linear-gradient(135deg, #fff 0 5px, #c9ced6 5px 6px); }
  .stack { display: flex; align-items: flex-end; gap: 5px; }
  .stack span { width: 30px; height: 30px; background: var(--blue); }
  .before { display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; }
  .before .was { display: block; height: 22px; padding-left: 8px; font-size: var(--fs-label); font-weight: 600; line-height: 22px; color: var(--mute); background: repeating-linear-gradient(135deg, #fff 0 5px, #c9ced6 5px 6px); }
  .before .now { display: block; width: 6px; height: 22px; background: var(--blue); }
  @media (max-width: 1100px) { .proof { grid-template-columns: repeat(2, 1fr); } .fig:nth-child(2) { border-right: 0; } .fig:nth-child(n + 3) { border-top: 1px solid var(--line); } .fig:nth-child(3) { padding-left: 0; } }
  @media (max-width: 600px) { .proof { grid-template-columns: 1fr; } .fig { padding-inline: 0; border-right: 0; } .fig + .fig { border-top: 1px solid var(--line); } }

  /* LOGOS */
  .logos { padding-block: 40px 56px; overflow: hidden; }
  .logos > p { font-size: var(--fs-small); color: var(--mute); margin-bottom: 24px; }
  .marquee { display: flex; width: max-content; animation: slide 38s linear infinite; }
  .marquee:hover { animation-play-state: paused; }
  .marquee ul { list-style: none; padding: 0 0 0 clamp(56px, 7vw, 112px); display: flex; align-items: center; gap: clamp(56px, 7vw, 112px); }
  .marquee img { width: auto; filter: brightness(0); opacity: 0.72; }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee { animation: none; flex-wrap: wrap; width: auto; } .marquee ul[aria-hidden] { display: none; } }

  /* DOULEURS */
  .pains h2 { max-width: 16ch; }
  .pains ul { list-style: none; padding: 0; margin-block: clamp(40px, 5vw, 64px); display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--ink); }
  .pains li { font-size: var(--fs-title); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; padding: clamp(24px, 3vw, 40px) clamp(0px, 3vw, 40px) clamp(24px, 3vw, 40px) 0; border-bottom: 1px solid var(--line); text-wrap: balance; }
  .pains li:nth-child(odd) { border-right: 1px solid var(--line); }
  .pains li:nth-child(even) { padding-left: clamp(16px, 3vw, 40px); }
  .pains .lede { max-width: 52ch; }
  @media (max-width: 700px) { .pains ul { grid-template-columns: 1fr; } .pains li:nth-child(odd) { border-right: 0; } .pains li:nth-child(even) { padding-left: 0; } }

  /* OFFRE */
  .offer h2, .cases h2, .reviews h2 { max-width: 18ch; margin-bottom: clamp(48px, 6vw, 88px); }
  .offer-grid { display: grid; grid-template-columns: minmax(180px, 260px) 1fr; gap: clamp(32px, 6vw, 112px); }
  .side-rail { list-style: none; padding: 0; position: sticky; top: 120px; align-self: start; border: 1px solid var(--ink); }
  .side-rail li { display: flex; gap: 14px; align-items: baseline; padding: 18px; font-weight: 900; text-transform: uppercase; font-size: var(--fs-body); color: #6b7280; background: repeating-linear-gradient(135deg, #fff 0 9px, var(--ghost) 9px 10px); transition: background 0.6s var(--ease), color 0.6s var(--ease); }
