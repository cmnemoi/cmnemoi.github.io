---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TALKS } from '../../talks';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const replays = TALKS.filter((t) => t.replay);
const dateFr = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// Un post LinkedIn par entrée : son URL et ses premières lignes.
const linkedinPosts = [
  {
    url: 'https://www.linkedin.com/feed/update/urn:li:share:7520767873213165569/',
    excerpt: 'Bon, j’ai fait une connerie : j’ai donné accès à ma vie à un agent IA. Mes mails, mon agenda, mes SMS, ma prospection commerciale. Tout. Trois semaines plus tard, ma productivité a été multipliée par l’infini.',
  },
];
---
<Base title="Blog" description="Articles techniques sur l’ingénierie logicielle, l’IA en production et l’open source.">
  <section class="wrap head">
    <h1 class="display">Le <em>blog</em>.</h1>
    <p class="lede">Ce que j’apprends en rendant des produits fiables : tests, architecture, CI, et ce qui se passe après la mise en prod.</p>
  </section>

  <section class="wrap list">
    <ul>
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.id}`}>
            <time datetime={p.data.date.toISOString()}>{dateFr(p.data.date)}</time>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {replays.length > 0 && (
    <section class="wrap li">
      <h2 class="display">En <em>vidéo</em>.</h2>
      <ul class="posts videos">
        {replays.map((t) => (
          <li>
            <a href={t.replay}>
              <img src={t.thumb} alt="" width="1280" height="720" loading="lazy" />
              <span><b>{t.title}</b><br />{t.event} · {dateFr(new Date(t.date))}</span>
              <span class="read">Voir le replay sur YouTube <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" /></svg></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap li">
    <h2 class="display">Sur <em>LinkedIn</em>.</h2>
    <ul class="posts">
      {linkedinPosts.map((p) => (
        <li>
          <a href={p.url}>
            <blockquote>{p.excerpt}</blockquote>
            <span class="read">Lire la suite sur LinkedIn <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 10h13M11 4.5 16.5 10 11 15.5" /></svg></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .head { padding-block: clamp(56px, 8vw, 120px) clamp(32px, 4vw, 56px); }
  h1 { font-size: var(--fs-display); margin-bottom: 28px; }
  .list { padding-block: 0 clamp(64px, 8vw, 120px); }
  ul { list-style: none; padding: 0; }
  li { border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  li a { display: grid; grid-template-columns: 200px 1fr; gap: 6px 40px; padding-block: 32px; text-decoration: none; }
  time { color: var(--mute); font-size: var(--fs-small); grid-row: span 2; padding-top: 8px; }
  li h2 { font-size: var(--fs-step); font-weight: 800; letter-spacing: -0.025em; line-height: 1.1; transition: color 0.2s; }
  li a:hover h2 { color: var(--blue); }
  li p { color: var(--mute); max-width: 70ch; }
  @media (max-width: 700px) { li a { grid-template-columns: 1fr; } time { grid-row: auto; } }
  .li { border-top: 1px solid var(--ink); }
  .li h2.display { margin-bottom: 48px; }
  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 32px; }
  .posts li, .posts li:last-child { border: 1px solid var(--ink); }
  .posts a { display: flex; flex-direction: column; justify-content: space-between; gap: 28px; height: 100%; padding: 28px; text-decoration: none; transition: border-color 0.2s; }
  .posts blockquote { font-size: var(--fs-body); line-height: 1.5; }
  .posts .read { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; color: var(--blue); }
  .posts .read svg { width: 18px; height: 18px; transition: transform 0.25s var(--ease); }
  .posts a:hover .read svg { transform: translateX(4px); }
  .posts a:hover { color: inherit; }
  .videos { grid-template-columns: repeat(auto-fill, minmax(min(100%, 560px), 1fr)); }
  .posts img { width: 100%; height: auto; border: 1px solid var(--line); }
  .posts b { font-size: var(--fs-step); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }
</style>
